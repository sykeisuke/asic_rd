L 4 -20 -10 -20 10 {}
L 4 -20 10 0 10 {}
L 4 0 10 0 -10 {}
L 4 0 -10 20 -10 {}
L 4 20 -10 20 10 {}
L 4 20 10 40 10 {}
B 5 77.5 -2.5 82.5 2.5 {name=out dir=out}
B 5 -82.5 -2.5 -77.5 2.5 {name=pbias dir=in}
B 5 -2.5 -62.5 2.5 -57.5 {name=vdd dir=inout}
B 5 -2.5 57.5 2.5 62.5 {name=vss dir=inout}
T {@name} -58 -58 0 0 0.25 0.25 {}
